{
  "app": {
    // 本机 build-profile.json5 里会有签名材料，已被 .gitignore 排除；这份是模板，
    // 复制成 build-profile.json5 后在 DevEco 里补 signingConfigs
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "compileSdkVersion": "6.1.0(23)",
        "compatibleSdkVersion": "6.1.0(23)",
        "targetSdkVersion": "6.1.0(23)",
        "runtimeOS": "HarmonyOS"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
